{
  "name": "fuellock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/smoke.mjs",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/database.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env scripts/database.ts seed",
    "db:reset": "tsx --env-file-if-exists=.env scripts/database.ts reset"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@libsql/client": "^0.17.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "drizzle-orm": "^0.45.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.6.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.0",
    "playwright-core": "^1.57.0",
    "postcss": "^8.5.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
